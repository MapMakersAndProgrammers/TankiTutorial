<library name="Tutorial Hangar">
	<prop-group name="Hangar">
		<prop name="Hangar In">
			<mesh file="hang_in.3dz"/>
		</prop>
		<prop name="Hangar Out">
			<mesh file="hang_out.3dz"/>
		</prop>
		<prop name="Door">
			<mesh file="door.3dz"/>
		</prop>
		<prop name="No Do">
			<mesh file="noDo.3dz"/>
		</prop>

		<prop name="Computer">
			<mesh file="computer.3dz"/>
		</prop>
		<prop name="Tool Desk">
			<mesh file="toolDesk.3dz"/>
		</prop>
		<prop name="Generator">
			<mesh file="gener.3dz"/>
		</prop>
		<prop name="Barrels 1">
			<mesh file="barr_1.3dz"/>
		</prop>
		<prop name="Barrels 2">
			<mesh file="barr_2.3dz"/>
		</prop>
		<prop name="Ammo">
			<mesh file="ammo.3dz"/>
		</prop>

		<prop name="Top Perils">
			<mesh file="topPeril.3dz"/>
		</prop>
		<prop name="Wires">
			<mesh file="wire_1.3dz"/>
		</prop>

	</prop-group>
</library>